{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-agent-band",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "secretagentband.illsea.com", "custom_domain": true }],
  // durable_object policy: the image and instance size are chosen in code (ctx.container.start), per
  // https://developers.cloudflare.com/containers/configuration/scheduling-policy/
  "containers": [
    {
      "class_name": "Band",
      "scheduling_policy": "durable_object",
      "images": { "hub": { "dockerfile": "../Dockerfile", "build_context": ".." } },
      "observability": { "logs": { "enabled": true } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BAND", "class_name": "Band" }, { "name": "HOUSE", "class_name": "HouseAgent" },
                 { "name": "ROHAN", "class_name": "Rohan" }]
  },
  // v2: the house agent (src/house.ts), a plain Durable Object that wakes itself with alarms; v3: Rohan, the bouncer
  // (src/rohan.ts), the same shape. Tags are applied in order and never change once deployed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Band"] }, { "tag": "v2", "new_sqlite_classes": ["HouseAgent"] },
                 { "tag": "v3", "new_sqlite_classes": ["Rohan"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "secret-agent-band-state" }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "triggers": { "crons": ["9,39 * * * *"] }, // the Doorman's heartbeat (GITHUB_DISPATCH_TOKEN) and the house agent's poke, in UTC
  "vars": { "PUBLIC_URL": "https://secretagentband.illsea.com", "HOUSE_HOURS": "17-1" }, // house agent: 5 PM to 1 AM Pacific
  "observability": { "enabled": true }
}
